# VoiceOnly Configuration File
# Copy this file to .env and update with your settings

# ===== DEBUG & SECURITY =====
# Set to True for verbose logging and development features
DEBUG_MODE=False

# IMPORTANT: Change this to a strong password!
# Used to access the admin dashboard at http://localhost:8000/admin
PASSWORD=changeme

# IMPORTANT: TOKEN USED FOR AUTHENTICATION IN API REQUESTS
TOKEN=123AB567

# ===== MONGODB CONFIGURATION =====
# Connection string to your MongoDB instance
# Local: mongodb://localhost:27017
# Remote with auth: mongodb://user:password@host:port/?authSource=admin
MONGODB_URI=mongodb://localhost:27017

# Database name to use
MONGODB_DB=voiceonly

# ===== PATHS =====
# Directory where downloaded audio files will be stored
# Can be absolute or relative path. Directory will be created if it doesn't exist
# Example: /mnt/media/podcasts or ./downloads
DOWNLOAD_PATH=./downloads

# ===== SERVER =====
# Binding address (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
HOST=0.0.0.0

# Server port
PORT=8000

# ===== REVERSE PROXY =====
# Set to True if running behind a reverse proxy (e.g. Caddy, Nginx)
BEHIND_PROXY=False

# Sub-path prefix if the app is served under a path (e.g. /voiceonly)
# Leave empty if served at root
PROXY_PATH=

# Comma-separated list of allowed hostnames (used by TrustedHostMiddleware)
# Example: voiceonly.example.com,localhost
# Leave empty to allow all hosts
TRUSTED_HOSTS=

# ===== WORKER SETTINGS =====
# How often (in hours) to scan channels for new uploads
# Minimum recommended: 3 hours, Default: 6 hours
# Higher values = less frequent scans = lower bandwidth usage
SCAN_INTERVAL_HOURS=6

# ===== OPTIONAL: YOUTUBE AUTHENTICATION =====
# Path to Netscape-format cookies file for YouTube authentication
# Useful for accessing restricted content or bypassing rate limits
# To export: Use browser extension like "Get cookies.txt"
# Example: /home/user/.config/voiceonly/cookies.txt
# COOKIES_FILE=/path/to/cookies.txt
