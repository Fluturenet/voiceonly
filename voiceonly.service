[Unit]
Description=VoiceOnly YouTube to Podcast service
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/voiceonly
Environment="PATH=/opt/voiceonly/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
EnvironmentFile=-/opt/voiceonly/.env
ExecStart=/opt/voiceonly/venv/bin/gunicorn -k uvicorn.workers.UvicornWorker "app.main:app" --bind 0.0.0.0:8000 --workers 2 --log-level info
Restart=always
RestartSec=5s
TimeoutSec=120

[Install]
WantedBy=multi-user.target
